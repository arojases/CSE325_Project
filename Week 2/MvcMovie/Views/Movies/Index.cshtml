@model MvcMovie.Models.MovieGenreViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>My Movies</h1>

<p>
    <button class="btn btn-primary">
        <a class="text-decoration-none link-light" asp-action="Create">Create New</a>
    </button>
</p>

<form asp-controller="Movies" asp-action="Index" method="get">
    <p>

        <label class="form-label col-form-label-lg">Genre: <select class="form-control" asp-for="MovieGenre" asp-items="Model.Genres">
            <option value="">All</option>
        </select></label>
        

        <label class="form-label col-form-label-lg">Title: <input class="form-control" type="text" asp-for="SearchString" /></label>
        <!-- <input type="submit" value="Filter" /> -->

        <label class="form-label col-form-label-lg">Year: <input class="form-control" type="number" min="1900" max="2100" asp-for="SearchYear" placeholder="YYYY" /></label>
        
        <input class="btn btn-success" type="submit" value="Filter" />
        
        
    </p>
</form>

<table class="table table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Genre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Movies![0].Rating)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Movies!)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReleaseDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rating)
                </td>
                <td>
                    <button class="btn btn-warning">
                        <a class="text-decoration-none link-dark" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    </button> 
                    <button class="btn btn-outline-dark">
                        <a class="text-decoration-none link-dark" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    </button> 
                    <button class="btn btn-danger">
                        <a class="text-decoration-none link-dark" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>