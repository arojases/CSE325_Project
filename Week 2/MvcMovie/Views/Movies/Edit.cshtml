@model MvcMovie.Models.Movie

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Movie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="form-label col-form-label-lg" asp-for="Title"></label>
                <input class="form-control" asp-for="Title" />
                <span class="text-danger" asp-validation-for="Title"></span>
            </div>
            <div class="form-group">
                <label class="form-label col-form-label-lg" asp-for="ReleaseDate"></label>
                <input class="form-control" asp-for="ReleaseDate" />
                <span class="text-danger" asp-validation-for="ReleaseDate"></span>
            </div>
            <div class="form-group">
                <label class="form-label col-form-label-lg" asp-for="Genre"></label>
                <input class="form-control" asp-for="Genre" />
                <span class="text-danger" asp-validation-for="Genre"></span>
            </div>
            <div class="form-group">
                <label class="form-label col-form-label-lg" asp-for="Price"></label>
                <input class="form-control" asp-for="Price" />
                <span class="text-danger" asp-validation-for="Price"></span>
            </div>
            <div class="form-group">
                <label class="form-label col-form-label-lg" asp-for="Rating"></label>
                <input class="form-control" asp-for="Rating" placeholder="G, PG, PG-13, R" />
                <span class="text-danger" asp-validation-for="Rating"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Save" class="form-control btn btn-success" />
            </div>
        </form>
    </div>
</div>
<br />
<div>
    <a class="text-decoration-none link-info" asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
